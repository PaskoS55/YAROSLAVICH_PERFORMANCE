// Schema for YAROSLAVICH PERFORMANCE
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Direction {
  HIGHER_IS_BETTER
  LOWER_IS_BETTER
  CONTEXTUAL
}

enum Category {
  STRENGTH
  POWER
  SPEED
  AGILITY
  VOLLEYBALL
  MOBILITY_STABILITY
  BODY_COMPOSITION
}

enum ChangeStatus {
  SIGNIFICANT_IMPROVEMENT
  SIGNIFICANT_DECREASE
  MINOR_CHANGE
  NO_CHANGE
  THRESHOLD_NOT_CONFIGURED
}

enum QCStatus {
  PASSED
  FAILED
  NOT_CHECKED
}

enum SessionPhase {
  PRESEASON
  CAMP
  INSEASON
  POSTSEASON
  RECOVERY
}

enum PlayerStatus {
  ACTIVE
  INJURED
  LIMITED
  INACTIVE
}

enum SessionStatus {
  FULL
  PARTIAL
  INCOMPLETE
  RESTRICTED
}

enum SessionSource {
  MANUAL
  MEDASS
  TENSOR_PLATFORM
  PHOTO_CELLS
  CSV
  API
  OTHER
}

model Organization {
  id        String    @id @default(cuid())
  name      String
  code      String    @unique
  teams     Team[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? @map("deleted_at")

  @@map("organizations")
}

model Team {
  id             String        @id @default(cuid())
  name           String
  code           String        @unique
  organization   Organization  @relation(fields: [organizationId], references: [id])
  organizationId String
  players        Player[]
  seasons        Season[]
  testSessions   TestSession[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?     @map("deleted_at")

  @@map("teams")
}

model Season {
  id        String        @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  teams     Team[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  sessions  TestSession[]
  deletedAt DateTime?     @map("deleted_at")

  @@map("seasons")
}

model Player {
  id               String            @id @default(cuid())
  playerId         String
  firstName        String
  lastName         String
  middleName       String?
  number           Int?
  position         String
  birthDate        DateTime?
  height           Int?
  status           PlayerStatus      @default(ACTIVE)
  joinedDate       DateTime?
  photoUrl         String?
  comment          String?
  team             Team              @relation(fields: [teamId], references: [id])
  teamId           String
  testResults      TestResult[]
  goals            PlayerGoal[]
  bodyCompositions BodyComposition[]
  testSessions     TestSession[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?         @map("deleted_at")

  @@unique([teamId, playerId])
  @@map("players")
}

model TestCategory {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  tests     Test[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("test_categories")
}

model Test {
  id              String        @id @default(cuid())
  code            String        @unique
  name            String
  description     String?
  category        Category
  categoryId      String?
  categoryRel     TestCategory? @relation(fields: [categoryId], references: [id])
  isSystem        Boolean       @default(false)
  createdBy       String?
  equipment       String?
  source          String?
  comment         String?
  direction       Direction
  unit            String
  qcMin           Float?
  qcMax           Float?
  qcDescription   String?
  norms           Norm[]
  testResults     TestResult[]
  goals           PlayerGoal[]
  changeThreshold Float?
  cv              Float?
  protocolData    String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?     @map("deleted_at")

  @@map("tests")
}

model TestSession {
  id               String            @id @default(cuid())
  sessionId        String            @unique
  DateTime         DateTime
  phase            SessionPhase
  time             DateTime?
  tester           String?
  location         String?
  equipmentId      String?
  status           SessionStatus     @default(FULL)
  source           SessionSource     @default(MANUAL)
  comment          String?           @db.Text
  player           Player            @relation(fields: [playerId], references: [id])
  playerId         String
  team             Team              @relation(fields: [teamId], references: [id])
  teamId           String
  season           Season            @relation(fields: [seasonId], references: [id])
  seasonId         String
  testResults      TestResult[]
  bodyCompositions BodyComposition[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?         @map("deleted_at")

  @@unique([playerId, DateTime, phase])
  @@map("test_sessions")
}

model TestResult {
  id               String         @id @default(cuid())
  value            Float
  score            Float?
  performanceDelta Float?
  changeStatus     ChangeStatus?
  pbAchieved       Boolean?
  pbImprovement    Float?
  test             Test           @relation(fields: [testId], references: [id])
  testId           String
  player           Player         @relation(fields: [playerId], references: [id])
  playerId         String
  testSession      TestSession    @relation(fields: [testSessionId], references: [id])
  testSessionId    String
  qcStatus         QCStatus       @default(NOT_CHECKED)
  qcFlags          QCFlag[]
  source           SessionSource? @default(MANUAL)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?      @map("deleted_at")
  Equipment        Equipment?     @relation(fields: [equipmentId], references: [id])
  equipmentId      String?

  @@unique([testSessionId, testId])
  @@map("test_results")
}

model Norm {
  id         String    @id @default(cuid())
  testCode   String
  position   String
  anchor10   Float
  anchor25   Float
  anchor50   Float
  anchor75   Float
  anchor90   Float
  source     String
  validFrom  DateTime  @default(now())
  validUntil DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime? @map("deleted_at")
  Test       Test?     @relation(fields: [testId], references: [id])
  testId     String?

  @@map("norms")
}

model PlayerGoal {
  id          String    @id @default(cuid())
  player      Player    @relation(fields: [playerId], references: [id])
  playerId    String
  test        Test      @relation(fields: [testId], references: [id])
  testId      String
  targetValue Float
  targetDate  DateTime
  achieved    Boolean   @default(false)
  achievedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? @map("deleted_at")

  @@map("player_goals")
}

model Equipment {
  id           String       @id @default(cuid())
  code         String       @unique
  name         String
  description  String?
  brand        String?
  model        String?
  status       String       @default("ACTIVE")
  purchaseDate DateTime?
  warrantyExp  DateTime?
  testResults  TestResult[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?    @map("deleted_at")

  @@map("equipment")
}

model BodyComposition {
  id            String      @id @default(cuid())
  player        Player      @relation(fields: [playerId], references: [id])
  playerId      String
  testSession   TestSession @relation(fields: [testSessionId], references: [id])
  testSessionId String
  mass_kg       Float?
  fat_pct       Float?
  ffm_kg        Float?
  phase_angle   Float?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?   @map("deleted_at")

  @@map("body_compositions")
}

model ImportJob {
  id             String    @id @default(cuid())
  fileName       String
  status         String
  recordsCount   Int?
  processedCount Int?
  errors         Json?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("import_jobs")
}

model QCFlag {
  id           String     @id @default(cuid())
  testResult   TestResult @relation(fields: [testResultId], references: [id])
  testResultId String
  field        String
  expected     String
  actual       String
  description  String?
  resolved     Boolean    @default(false)
  resolvedBy   String?
  resolvedAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("qc_flags")
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String
  oldValues Json?
  newValues Json?
  userId    String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}